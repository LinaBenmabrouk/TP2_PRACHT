---
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

interface Props {
  species: string;
}

const { species } = Astro.props;
const filteredPenguins = penguins.filter((p) => p.species === species);

const plotOptions = {
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species"
    })
  ]
};
---

<div class="graphic-container my-4">
  <h2 class="text-xl font-bold mb-2">Espèce : {species}</h2>
  <div set:html={Plot.plot(plotOptions).outerHTML} />
</div>
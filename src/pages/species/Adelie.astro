---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">

      <h1 class="mb-8 text-3xl font-semibold">Penguins Adelie</h1>

      <nav class="mb-8 flex gap-4">
        <a href="/species/Adelie">Adelie</a>
        <a href="/species/Gentoo">Gentoo</a>
        <a href="/species/Chinstrap">Chinstrap</a>
      </nav>

      <section class="border border-slate-200 bg-white p-5">
        <GraphicSpecies species="Adelie" />
      </section>

    </main>
  </div>
</Layout>
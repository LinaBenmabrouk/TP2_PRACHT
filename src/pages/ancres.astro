---
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <header class="mb-10 border-b border-slate-300 pb-7">
        <a
          href="/"
          class="mb-2 block text-sm font-medium text-slate-500 hover:text-slate-800"
        >
          TP Observable Plot
        </a>

        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Les espèces de Penguins
        </h1>

        <p class="mt-3 text-base text-slate-600">
          Visualisation des différentes espèces de manchots.
        </p>
      </header>

      <SiteNavigation />

      <nav class="mb-8 flex gap-4">
        <a href="#Adelie" class="menu-item px-4 py-2 [.active]:bg-red-200">Adelie</a>
        <a href="#Gentoo" class="menu-item px-4 py-2 [.active]:bg-red-200">Gentoo</a>
        <a href="#Chinstrap" class="menu-item px-4 py-2 [.active]:bg-red-200">Chinstrap</a>
      </nav>

      <div class="flex overflow-x-auto">
        <section id="Adelie" class="item min-w-full border border-slate-200 bg-white">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Adelie</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Adelie" />
          </div>
        </section>

        <section id="Gentoo" class="item min-w-full border border-slate-200 bg-white">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Gentoo</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Gentoo" />
          </div>
        </section>

        <section id="Chinstrap" class="item min-w-full border border-slate-200 bg-white">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Chinstrap</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Chinstrap" />
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    const menuItems = document.querySelectorAll(".menu-item");
    const items = document.querySelectorAll(".item");

    console.log("menuItems", menuItems);
    console.log("items", items);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute("id");
          const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);

          if (entry.isIntersecting) {
            menuItem?.classList.add("active");
          } else {
            menuItem?.classList.remove("active");
          }
        });
      },
      { threshold: 0.5 },
    );

    items.forEach((item) => observer.observe(item));
  </script>
</Layout>